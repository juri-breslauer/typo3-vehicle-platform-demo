{
  "name": "juri/typo3-vehicle-platform-demo",
  "description": "TYPO3 demo project with a custom vehicle catalog extension",
  "type": "project",
  "license": "MIT",
  "require": {
    "typo3/cms-core": "^14.0.1",
    "typo3/cms-backend": "^14.0.1",
    "typo3/cms-frontend": "^14.0.1",
    "typo3/cms-extbase": "^14.0.1",
    "typo3/cms-fluid": "^14.0.1",
    "typo3/cms-install": "^14.0.1",
    "typo3/cms-extensionmanager": "^14.0.1"
  },
  "extra": {
    "typo3/cms": {
      "web-dir": "web",
      "extension-dir": "packages"
    }
  },
  "config": {
    "allow-plugins": {
      "typo3/cms-composer-installers": true,
      "typo3/class-alias-loader": true
    }
  }
}
